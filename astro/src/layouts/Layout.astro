---
import "../styles/global.css";
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Tabs, TabItem } from '@astrojs/starlight/components';
import Projects from "../pages/projects.astro";
import Experiences from "../pages/experiences.astro";
const fullName = "Alaere Nekekpemi";
const pitch = "Full-stack Engineer";
---

<StarlightPage frontmatter={{ title: `${fullName} | Software Engineer`, template: "splash",  tableOfContents: false,}}>
    <Tabs>
      <TabItem label="Projects">
        <Projects/>
      </TabItem>
      <TabItem label="Experiences">
        <Experiences/>
      </TabItem>
    </Tabs>
  <footer>© Alaere Nekekpemi. Built with Astro.</footer>
</StarlightPage>