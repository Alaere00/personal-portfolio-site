---
import { Icon } from '@astrojs/starlight/components';
const { title } = Astro.locals.starlightRoute.entry.data;
const links = [
  { href: 'https://www.linkedin.com/in/alaere', icon: 'linkedin', label: 'LinkedIn' },
  { href: 'https://github.com/Alaere00', icon: 'github', label: 'GitHub' },
  {href: '', icon: 'file', label: 'Resume'},
];
const intro = "Full-stack engineer building accessible, user-friendly products for the web, from React interfaces to Python services."
---

<h1>{title}
    <p style="font-size: 1rem; font-weight: 400;">{intro}</p>
    <div class="row">
        {links.map((link) => (
            <a href={link.href} aria-label={link.label}><Icon size="1.75rem" color="white" name={link.icon}></Icon></a>
        ))}
    </div>
</h1>